#include <Arduino.h>

// ECE 4180 Lab 2 Part 1 Extra Credit
// ESP32-S3 -> CH9328 Mode 3
// GPIO17 -> CH9328 RX
// GND -> CH9328 GND

const int TX_PIN = 17;
const int CENTER = 15;

// CHANGE to your actual assigned board number
const uint8_t BOARD_NUMBER = 67;

// Placeholder timing; must match DDR website
const unsigned long BEAT_MS = 750;
const unsigned long START_DELAY_MS = 3000;

const uint8_t arrows[4] = {
  0x50, 0x51, 0x52, 0x4F
}; // Left, Down, Up, Right

const char* names[4] = {
  "LEFT", "DOWN", "UP", "RIGHT"
};

uint16_t lfsr_state;

bool playing = false;
unsigned long nextBeat = 0;
int count = 0;

void prng_init(uint8_t board_id) {
  lfsr_state = ((uint16_t)board_id << 8) | (board_id ^ 0x5A);

  if (lfsr_state == 0) {
    lfsr_state = 0xACE1;
  }
}

uint8_t prng_step() {
  uint8_t lsb = lfsr_state & 1;
  lfsr_state >>= 1;

  if (lsb == 1) {
    lfsr_state ^= 0xB400;
  }

  return lfsr_state % 4;
}

void tap(uint8_t key) {
  uint8_t press[8] = {0,0,key,0,0,0,0,0};
  uint8_t release[8] = {0};

  Serial1.write(press, 8);
  delay(50);

  Serial1.write(release, 8);
}

void setup() {
  Serial.begin(115200);

  Serial1.begin(9600, SERIAL_8N1, -1, TX_PIN);

  uint8_t release[8] = {0};
  Serial1.write(release, 8);

  pinMode(CENTER, INPUT_PULLUP);

  prng_init(BOARD_NUMBER);

  Serial.println("DDR Automatic Player");
  Serial.println("Press CENTER to start");
}

void loop() {

  if (!playing && digitalRead(CENTER) == LOW) {
    delay(20);

    if (digitalRead(CENTER) == LOW) {
      prng_init(BOARD_NUMBER);

      count = 0;
      nextBeat = millis() + START_DELAY_MS;
      playing = true;

      Serial.println("Starting DDR!");

      while (digitalRead(CENTER) == LOW) {
        delay(10);
      }
    }
  }

  if (playing && (long)(millis() - nextBeat) >= 0) {

    uint8_t dir = prng_step();
    uint8_t key = arrows[dir];

    tap(key);

    count++;

    Serial.print("Step ");
    Serial.print(count);
    Serial.print(": ");
    Serial.println(names[dir]);

    nextBeat += BEAT_MS;
  }
}
