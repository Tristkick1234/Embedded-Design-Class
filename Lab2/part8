
#include <Arduino.h>
#include <Wire.h>
#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ST7789.h>
#include <Adafruit_MPR121.h>
#include <Adafruit_ICM20948.h>
#include <Adafruit_Sensor.h>

// ECE 4180 Lab 2 - Part 8
// ESP32-C6 Board #34

const uint8_t BOARD_NUMBER = 34;

// Shared I2C bus
#define SDA_PIN 6
#define SCL_PIN 7

// ST7789 LCD - SPI
#define TFT_SCLK 10
#define TFT_MOSI 11
#define TFT_DC 18
#define TFT_CS 19
#define TFT_RST 20

#define SCREEN_W 240
#define SCREEN_H 240

#define DAC_ADDR 0x60

Adafruit_ST7789 tft =
  Adafruit_ST7789(&SPI, TFT_CS, TFT_DC, TFT_RST);

Adafruit_MPR121 cap;
Adafruit_ICM20948 imu;

// LEFT, DOWN, UP, RIGHT
const int pads[4] = {2, 5, 7, 10};
const char* symbols[4] = {"<", "v", "^", ">"};

const uint16_t colors[4] = {
  ST77XX_GREEN,
  ST77XX_CYAN,
  ST77XX_MAGENTA,
  ST77XX_YELLOW
};

const int frequencies[4] = {130, 165, 196, 247};

uint16_t lfsr_state;
uint16_t lastTouch = 0;

int score = 0;
int combo = 0;
int misses = 0;

char feedback[20] = "READY";

// Game settings
const unsigned long BEAT_MS = 850;
const unsigned long TRAVEL_MS = 1800;
const int PERFECT_MS = 100;
const int GOOD_MS = 220;

// Game objects
struct Note {
  int direction;
  unsigned long hitTime;
  bool active;
};

Note notes[12];

unsigned long nextSpawn = 0;
unsigned long nextIMU = 0;
unsigned long nextKeypad = 0;
unsigned long nextDisplay = 0;

// IMU
float baseX = 0;
float baseY = 0;
bool imuArmed = true;

// DAC sound
unsigned long toneEnd = 0;
unsigned long nextSample = 0;
unsigned long samplePeriod = 1000;
int waveStep = 0;

// ---------- LFSR ----------

void prng_init(uint8_t board_id) {
  lfsr_state = ((uint16_t)board_id << 8) |
               (board_id ^ 0x5A);

  if (lfsr_state == 0) {
    lfsr_state = 0xACE1;
  }
}

uint8_t prng_step() {
  uint8_t lsb = lfsr_state & 1;
  lfsr_state >>= 1;

  if (lsb == 1) {
    lfsr_state ^= 0xB400;
  }

  return lfsr_state % 4;
}

// ---------- DAC ----------

void dacWrite(uint16_t value) {
  Wire.beginTransmission(DAC_ADDR);
  Wire.write((value >> 8) & 0x0F);
  Wire.write(value & 0xFF);
  Wire.endTransmission();
}

void playSound(int direction) {
  samplePeriod =
    1000000UL / (frequencies[direction] * 4UL);

  waveStep = 0;
  nextSample = micros();
  toneEnd = millis() + 80;
}

void updateSound() {
  if (toneEnd == 0) return;

  if ((long)(millis() - toneEnd) >= 0) {
    dacWrite(2048);
    toneEnd = 0;
    return;
  }

  if ((long)(micros() - nextSample) >= 0) {
    const uint16_t wave[4] = {
      2048, 2800, 2048, 1296
    };

    dacWrite(wave[waveStep]);
    waveStep = (waveStep + 1) % 4;
    nextSample = micros() + samplePeriod;
  }
}

// ---------- LCD DISPLAY ----------

void drawBackground() {
  tft.fillScreen(ST77XX_BLACK);

  tft.setTextSize(2);
  tft.setTextColor(ST77XX_WHITE);
  tft.setCursor(8, 5);
  tft.print("DDR BOARD 34");

  // Four lanes, each 60 pixels wide
  for (int i = 1; i < 4; i++) {
    tft.drawFastVLine(i * 60, 52, 178,
                      ST77XX_WHITE);
  }

  // Hit line
  tft.drawFastHLine(0, 194, 240, ST77XX_RED);
}

void drawGame() {
  // Clear gameplay area
  tft.fillRect(0, 52, 240, 183, ST77XX_BLACK);

  // Four lanes
  for (int i = 1; i < 4; i++) {
    tft.drawFastVLine(i * 60, 52, 178,
                      ST77XX_WHITE);
  }

  tft.drawFastHLine(0, 194, 240, ST77XX_RED);

  // Target arrows
  for (int i = 0; i < 4; i++) {
    tft.setTextSize(2);
    tft.setTextColor(colors[i]);
    tft.setCursor(i * 60 + 23, 203);
    tft.print(symbols[i]);
  }

  unsigned long now = millis();

  // Draw moving arrows
  for (int i = 0; i < 12; i++) {
    if (!notes[i].active) continue;

    long remaining =
      (long)(notes[i].hitTime - now);

    long y = 194 -
             (remaining * 140L / TRAVEL_MS);

    if (y < 54 || y > 224) continue;

    int dir = notes[i].direction;
    int x = dir * 60 + 18;

    tft.setTextSize(3);
    tft.setTextColor(colors[dir]);
    tft.setCursor(x, (int)y);
    tft.print(symbols[dir]);
  }

  // Score area
  tft.fillRect(0, 25, 240, 25, ST77XX_BLACK);

  tft.setTextSize(1);
  tft.setTextColor(ST77XX_WHITE);

  tft.setCursor(5, 29);
  tft.print("SCORE:");
  tft.print(score);

  tft.setCursor(127, 29);
  tft.print("COMBO:");
  tft.print(combo);

  tft.setCursor(5, 41);
  tft.print(feedback);

  tft.setCursor(150, 41);
  tft.print("MISS:");
  tft.print(misses);
}

// ---------- GAME LOGIC ----------

void spawnNote(unsigned long spawnTime) {
  for (int i = 0; i < 12; i++) {
    if (!notes[i].active) {
      notes[i].direction = prng_step();
      notes[i].hitTime = spawnTime + TRAVEL_MS;
      notes[i].active = true;
      return;
    }
  }
}

void hitArrow(int direction) {
  int best = -1;
  unsigned long bestError = 999999;
  unsigned long now = millis();

  for (int i = 0; i < 12; i++) {
    if (!notes[i].active) continue;
    if (notes[i].direction != direction) continue;

    unsigned long error =
      now >= notes[i].hitTime ?
      now - notes[i].hitTime :
      notes[i].hitTime - now;

    if (error < bestError) {
      bestError = error;
      best = i;
    }
  }

  if (best >= 0 && bestError <= GOOD_MS) {
    notes[best].active = false;

    if (bestError <= PERFECT_MS) {
      score += 100;
      strcpy(feedback, "PERFECT +100");
    } else {
      score += 50;
      strcpy(feedback, "GOOD +50");
    }

    combo++;
    playSound(direction);
  } else {
    combo = 0;
    strcpy(feedback, "BAD TIMING");
  }
}

void checkMisses() {
  unsigned long now = millis();

  for (int i = 0; i < 12; i++) {
    if (notes[i].active &&
        (long)(now - notes[i].hitTime) > GOOD_MS) {
      notes[i].active = false;
      misses++;
      combo = 0;
      strcpy(feedback, "MISS");
    }
  }
}

// ---------- CAPACITIVE KEYPAD ----------

void checkKeypad() {
  uint16_t touched = cap.touched();
  uint16_t newlyTouched = touched & ~lastTouch;

  for (int i = 0; i < 4; i++) {
    if (newlyTouched & (1 << pads[i])) {
      hitArrow(i);
    }
  }

  lastTouch = touched;
}

// ---------- IMU ----------

void checkIMU() {
  sensors_event_t accel, gyro, temp, mag;
  imu.getEvent(&accel, &gyro, &temp, &mag);

  float x = accel.acceleration.x - baseX;
  float y = accel.acceleration.y - baseY;

  int direction = -1;

  if (x > 4) direction = 3;
  else if (x < -4) direction = 0;
  else if (y > 4) direction = 2;
  else if (y < -4) direction = 1;

  // Require neutral position between IMU inputs
  if (abs(x) < 2 && abs(y) < 2) {
    imuArmed = true;
  }

  if (direction >= 0 && imuArmed) {
    hitArrow(direction);
    imuArmed = false;
  }
}

// ---------- SETUP ----------

void setup() {
  Serial.begin(115200);
  delay(1000);

  Wire.begin(SDA_PIN, SCL_PIN, 400000);

  if (!cap.begin(0x5A, &Wire)) {
    Serial.println("MPR121 not found");
    while (1) delay(100);
  }

  if (!imu.begin_I2C(0x69, &Wire) &&
      !imu.begin_I2C(0x68, &Wire)) {
    Serial.println("IMU not found");
    while (1) delay(100);
  }

  Wire.beginTransmission(DAC_ADDR);
  if (Wire.endTransmission() != 0) {
    Serial.println("DAC not found");
    while (1) delay(100);
  }

  SPI.begin(TFT_SCLK, -1, TFT_MOSI, TFT_CS);
  tft.init(240, 240, SPI_MODE0);
  tft.setSPISpeed(20000000);
  tft.setRotation(2);
  drawBackground();

  Serial.println("Keep IMU flat!");
  delay(1000);

  sensors_event_t a, g, t, m;
  imu.getEvent(&a, &g, &t, &m);

  baseX = a.acceleration.x;
  baseY = a.acceleration.y;

  prng_init(BOARD_NUMBER);

  for (int i = 0; i < 12; i++) {
    notes[i].active = false;
  }

  lastTouch = cap.touched();

  dacWrite(2048);

  nextSpawn = millis() + 1000;
  nextIMU = millis();
  nextKeypad = millis();
  nextDisplay = millis();

  Serial.println("DDR GAME START!");
}

// ---------- LOOP ----------

void loop() {
  unsigned long now = millis();

  if ((long)(now - nextSpawn) >= 0) {
    spawnNote(nextSpawn);
    nextSpawn += BEAT_MS;
  }

  if ((long)(now - nextKeypad) >= 0) {
    checkKeypad();
    nextKeypad = millis() + 12;
  }

  if ((long)(now - nextIMU) >= 0) {
    checkIMU();
    nextIMU = millis() + 40;
  }

  checkMisses();
  updateSound();

  if ((long)(now - nextDisplay) >= 0) {
    drawGame();
    nextDisplay = millis() + 40;
  }
}
